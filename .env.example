# Copy to .env and fill in. .env is gitignored — JD: "no credentials in code".

# --- Azure SQL Database connection ---
# Get these from the Azure portal after you create the SQL DB.
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=hkn_asset
SQL_USERNAME=hkn_admin
SQL_PASSWORD=change-me
SQL_DRIVER=ODBC Driver 18 for SQL Server

# --- API auth (simple API key for the learning project) ---
API_KEY=change-me-too

# --- Paths ---
INCOMING_DIR=sample_data/incoming
PROCESSED_DIR=sample_data/processed
